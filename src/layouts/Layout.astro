---
import { ruta } from '../lib/ruta.ts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Página a pantalla completa sin scroll (el juego). */
  fija?: boolean;
}

const {
  title = '¿Quién llevó a Tiger al veterinario?',
  description = 'Begoña investiga quién llevó a Tiger, el gato de Neyba, al veterinario de Barbate: seis sospechosos, seis vehículos, seis horas y una sola verdad.',
  fija = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#062a3a" />
    <link rel="icon" type="image/svg+xml" href={ruta("/favicon.svg")} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class:list={['bg-noche-950 font-sans text-crema antialiased', fija && 'h-svh overflow-hidden overscroll-none']}>
    <div class="escenario" aria-hidden="true"></div>
    <slot />
  </body>
</html>

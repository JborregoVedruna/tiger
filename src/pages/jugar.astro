---
import { ruta } from '../lib/ruta.ts';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Investigar · ¿Quién llevó a Tiger al veterinario?" fija>
  <div class="flex h-svh flex-col">
    <header
      class="flex shrink-0 items-center justify-between gap-2 border-b border-champan-500/15 bg-noche-950/80 px-2 pt-[env(safe-area-inset-top)] backdrop-blur"
    >
      <a href={ruta("/")} class="flex min-h-12 items-center gap-1 rounded-lg px-2 font-sans text-sm font-semibold text-champan-400">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
        Inicio
      </a>
      <div class="min-w-0 text-center">
        <p class="truncate font-display text-base text-crema">El misterio de Tiger</p>
        <p id="estado-caso" class="font-sans text-[10px] font-bold tracking-[0.2em] text-champan-500 uppercase"></p>
      </div>
      <button
        id="abrir-cuaderno"
        type="button"
        aria-controls="cuaderno"
        aria-expanded="false"
        class="flex min-h-12 items-center gap-1.5 rounded-lg px-2 font-sans text-sm font-semibold text-champan-400"
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 4h11a3 3 0 013 3v13H8a3 3 0 01-3-3V4z"></path>
          <path d="M5 17a3 3 0 013-3h11M9 8h6"></path>
        </svg>
        Cuaderno
      </button>
    </header>

    <main class="relative min-h-0 flex-1">
      <div id="juego" class="absolute inset-0" aria-label="Mesa de investigación"></div>
      <noscript>
        <p class="p-6 text-center">Necesitas JavaScript para investigar el caso.</p>
      </noscript>
    </main>

    <div id="barra-acusar" class="hidden shrink-0 border-t border-champan-500/20 bg-noche-950/90 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]">
      <button
        id="btn-acusar"
        type="button"
        class="mx-auto block min-h-14 w-full max-w-md rounded-2xl bg-fucsia-700 font-sans text-base font-bold tracking-wide text-crema uppercase shadow-lg shadow-black/40 ring-1 ring-champan-500/60 transition active:scale-[0.98]"
      >
        Resolver el caso: Acusar
      </button>
    </div>
  </div>

  <!-- Cuaderno de deducción -->
  <div id="capa-cuaderno" class="pointer-events-none fixed inset-0 z-40 bg-black/60 opacity-0 transition-opacity"></div>
  <aside
    id="cuaderno"
    aria-hidden="true"
    aria-label="Cuaderno de deducción"
    inert
    class="fixed inset-y-0 right-0 z-40 flex w-full max-w-md translate-x-full flex-col border-l border-champan-500/20 bg-noche-900 transition-transform duration-300"
  >
    <div class="flex shrink-0 items-center justify-between border-b border-noche-700 px-4 pt-[env(safe-area-inset-top)]">
      <h2 class="py-4 font-display text-xl text-crema">Cuaderno de deducción</h2>
      <button
        id="cerrar-cuaderno"
        type="button"
        class="grid size-12 place-items-center rounded-full text-champan-400"
        aria-label="Cerrar cuaderno"
      >
        <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <div
      id="cuaderno-cuerpo"
      class="flex-1 overflow-y-auto overscroll-contain px-4 pt-4 pb-[max(1.5rem,env(safe-area-inset-bottom))]"
    >
    </div>
  </aside>

  <div id="modal-raiz"></div>

  <div
    id="toast"
    role="status"
    aria-live="polite"
    class="pointer-events-none fixed inset-x-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-[60] mx-auto max-w-sm translate-y-4 rounded-xl border border-champan-500/40 bg-noche-800 px-4 py-3 text-center font-sans text-sm text-crema opacity-0 shadow-xl transition"
  >
  </div>
</Layout>

<script>
  import { arrancar } from '../game/main.ts';
  const contenedor = document.getElementById('juego');
  if (contenedor) arrancar(contenedor);
</script>
